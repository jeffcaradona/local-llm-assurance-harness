HARNESS_MODEL_BASE_URL=http://127.0.0.1:11434/v1
HARNESS_MODEL_ID=local-model
HARNESS_MODEL_API_KEY=
HARNESS_ALLOW_NON_LOCAL_ENDPOINT=false
HARNESS_OUTPUT_DIR=
HARNESS_MODEL_MAX_TOKENS=
HARNESS_MODEL_TEMPERATURE=0.2
HARNESS_MODEL_REASONING_EFFORT=
HARNESS_MODEL_TIMEOUT_MS=180000
# Used only by opt-in review --investigate; blank values use these defaults.
# Integers: model calls 1..100 (includes final); model-requested tools 0..100.
HARNESS_INVESTIGATE_MAX_MODEL_CALLS=8
HARNESS_INVESTIGATE_MAX_TOOL_CALLS=6
# Overall deadline after admission, milliseconds 1..2147483647.
HARNESS_INVESTIGATE_TIMEOUT_MS=600000
HARNESS_REDACT_SECRET_1=
HARNESS_REDACT_SECRET_2=
